{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oxford-finance-hub-v3-production",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "83594d99b138428fb3ef94ebd114601d"
    }
  ],
  "vars": {
    "CONTEXT": "cloudflare-production",
    "OXFORD_APPLICATIONS_ENABLED": "false",
    "OXFORD_DOCUMENT_UPLOADS_ENABLED": "false",
    "OXFORD_EMAIL_DELIVERY_ENABLED": "false",
    "OXFORD_INITIAL_SUPER_ADMIN_BOOTSTRAP_ENABLED": "false",
    "OXFORD_INITIAL_SUPER_ADMIN_EMAIL": "oxfordbusinessgroup@outlook.com",
    "OXFORD_NOTIFICATION_ADMIN_EMAIL": "oxfordbusinessgroup@outlook.com",
    "OXFORD_NOTIFICATION_FROM_EMAIL": "elizeb@oxfordbusinessgroup.co.za",
    "OXFORD_NOTIFICATION_FROM_NAME": "Oxford Business Group",
    "SUPABASE_URL": "https://wgcnawtnkblivfirclvz.supabase.co",
    "SUPABASE_BUCKET": "oxford-customer-documents"
  }
}